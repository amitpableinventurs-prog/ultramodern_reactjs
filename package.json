{
  "name": "ultramodern-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract-content.mjs",
    "mockups": "node scripts/generate-portfolio-mockups.mjs",
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-server",
    "build": "npm run cms:seed && npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "seo:check": "node scripts/seo-audit.mjs",
    "api": "php -S 127.0.0.1:8091 -t public public/api/dev-router.php",
    "backup:mysql": "php scripts/backup-mysql.php",
    "cms:seed": "node scripts/build-cms-seed.mjs",
    "backup:mongo": "node --no-warnings=ExperimentalWarning scripts/backup-to-mongo.mjs",
    "backup:mongo:single": "node --no-warnings=ExperimentalWarning scripts/backup-to-mongo.mjs --single"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "cheerio": "^1.0.0",
    "mongodb": "^6.22.0",
    "vite": "^5.4.10"
  }
}
